# Laravel Backend Development Patterns

## **Controller Organization**

### **Resource Controllers**
```php
<?php

namespace App\Http\Controllers;

use App\Models\Student;
use App\Http\Requests\StoreStudentRequest;
use App\Http\Requests\UpdateStudentRequest;
use Illuminate\Http\Request;
use Inertia\Inertia;

class StudentController extends Controller
{
    public function index(Request $request)
    {
        $query = Student::query();

        // Apply filters
        if ($request->filled('search')) {
            $query->where(function ($q) use ($request) {
                $q->where('first_name', 'like', "%{$request->search}%")
                  ->orWhere('last_name', 'like', "%{$request->search}%")
                  ->orWhere('student_number', 'like', "%{$request->search}%");
            });
        }

        if ($request->filled('section')) {
            $query->where('section', $request->section);
        }

        $students = $query->paginate(15);

        return Inertia::render('Admin/Student/List', [
            'students' => $students,
            'filters' => $request->only(['search', 'section']),
        ]);
    }

    public function store(StoreStudentRequest $request)
    {
        $student = Student::create($request->validated());

        return redirect()->route('student.index')
            ->with('success', 'Student created successfully.');
    }

    public function update(UpdateStudentRequest $request, Student $student)
    {
        $student->update($request->validated());

        return redirect()->route('student.index')
            ->with('success', 'Student updated successfully.');
    }

    public function destroy(Student $student)
    {
        $student->delete();

        return redirect()->route('student.index')
            ->with('success', 'Student deleted successfully.');
    }
}
```

### **API Controllers**
```php
<?php

namespace App\Http\Controllers\Api;

use App\Http\Controllers\Controller;
use App\Models\Student;
use App\Services\StudentService;
use Illuminate\Http\Request;
use Illuminate\Http\JsonResponse;

class StudentApiController extends Controller
{
    public function __construct(
        private StudentService $studentService
    ) {}

    public function index(Request $request): JsonResponse
    {
        $students = $this->studentService->getPaginatedStudents($request);

        return response()->json([
            'data' => $students,
            'message' => 'Students retrieved successfully',
        ]);
    }

    public function store(Request $request): JsonResponse
    {
        $validated = $request->validate([
            'student_number' => 'required|string|unique:students',
            'first_name' => 'required|string|max:255',
            'last_name' => 'required|string|max:255',
            // ... other validation rules
        ]);

        $student = $this->studentService->createStudent($validated);

        return response()->json([
            'data' => $student,
            'message' => 'Student created successfully',
        ], 201);
    }
}
```

## **Model Relationships & Eloquent**

### **Model Definitions**
```php
<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\BelongsTo;
use Illuminate\Database\Eloquent\Relations\HasMany;
use Illuminate\Database\Eloquent\SoftDeletes;

class Student extends Model
{
    use HasFactory, SoftDeletes;

    protected $fillable = [
        'user_id',
        'student_number',
        'first_name',
        'last_name',
        'middle_name',
        'section_id',
        'specialization',
        'is_active',
    ];

    protected $casts = [
        'is_active' => 'boolean',
        'created_at' => 'datetime',
        'updated_at' => 'datetime',
        'deleted_at' => 'datetime',
    ];

    // Relationships
    public function user(): BelongsTo
    {
        return $this->belongsTo(User::class);
    }

    public function section(): BelongsTo
    {
        return $this->belongsTo(Section::class);
    }

    public function placements(): HasMany
    {
        return $this->hasMany(StudentPlacement::class);
    }

    public function scores(): HasMany
    {
        return $this->hasMany(StudentScore::class);
    }

    // Accessors
    public function getFullNameAttribute(): string
    {
        $name = $this->last_name . ', ' . $this->first_name;
        
        if ($this->middle_name) {
            $name .= ' ' . strtoupper($this->middle_name[0]) . '.';
        }
        
        return $name;
    }

    // Scopes
    public function scopeActive($query)
    {
        return $query->where('is_active', true);
    }

    public function scopeBySection($query, $sectionId)
    {
        return $query->where('section_id', $sectionId);
    }

    // Methods
    public function isVerified(): bool
    {
        return $this->user && $this->user->email_verified_at !== null;
    }

    public function getCurrentPlacement(): ?StudentPlacement
    {
        return $this->placements()
            ->where('status', 'active')
            ->latest()
            ->first();
    }
}
```

### **Complex Relationships**
```php
<?php

namespace App\Models;

class StudentScore extends Model
{
    protected $fillable = [
        'student_id',
        'sub_category_id',
        'mean_score',
    ];

    protected $casts = [
        'mean_score' => 'integer',
    ];

    // Composite primary key relationship
    public function student(): BelongsTo
    {
        return $this->belongsTo(Student::class);
    }

    public function subCategory(): BelongsTo
    {
        return $this->belongsTo(SubCategory::class);
    }

    // Custom relationship for aggregated scores
    public function scopeByCategory($query, $categoryId)
    {
        return $query->whereHas('subCategory', function ($q) use ($categoryId) {
            $q->where('category_id', $categoryId);
        });
    }
}
```

## **Service Layer Pattern**

### **Service Classes**
```php
<?php

namespace App\Services;

use App\Models\Student;
use App\Models\User;
use Illuminate\Database\Eloquent\Collection;
use Illuminate\Pagination\LengthAwarePaginator;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Hash;

class StudentService
{
    public function getPaginatedStudents(Request $request): LengthAwarePaginator
    {
        $query = Student::with(['user', 'section'])
            ->active();

        // Apply search filters
        if ($request->filled('search')) {
            $query->where(function ($q) use ($request) {
                $search = $request->search;
                $q->where('first_name', 'like', "%{$search}%")
                  ->orWhere('last_name', 'like', "%{$search}%")
                  ->orWhere('student_number', 'like', "%{$search}%")
                  ->orWhereHas('user', function ($userQuery) use ($search) {
                      $userQuery->where('email', 'like', "%{$search}%");
                  });
            });
        }

        // Apply section filter
        if ($request->filled('section')) {
            $query->bySection($request->section);
        }

        // Apply sorting
        $sortBy = $request->get('sort_by', 'created_at');
        $sortDirection = $request->get('sort_direction', 'desc');
        $query->orderBy($sortBy, $sortDirection);

        return $query->paginate($request->get('per_page', 15));
    }

    public function createStudent(array $data): Student
    {
        return DB::transaction(function () use ($data) {
            // Create user account
            $user = User::create([
                'username' => $data['student_number'],
                'email' => $data['email'],
                'password' => Hash::make($data['password']),
                'role' => 'student',
            ]);

            // Create student profile
            $student = Student::create([
                'user_id' => $user->id,
                'student_number' => $data['student_number'],
                'first_name' => $data['first_name'],
                'last_name' => $data['last_name'],
                'middle_name' => $data['middle_name'] ?? null,
                'section_id' => $data['section_id'],
                'specialization' => $data['specialization'] ?? null,
                'is_active' => true,
            ]);

            // Send verification email
            $user->sendEmailVerificationNotification();

            return $student->load('user', 'section');
        });
    }

    public function updateStudent(Student $student, array $data): Student
    {
        return DB::transaction(function () use ($student, $data) {
            // Update student data
            $student->update([
                'first_name' => $data['first_name'],
                'last_name' => $data['last_name'],
                'middle_name' => $data['middle_name'] ?? null,
                'section_id' => $data['section_id'],
                'specialization' => $data['specialization'] ?? null,
            ]);

            // Update user data if provided
            if (isset($data['email'])) {
                $student->user->update(['email' => $data['email']]);
            }

            return $student->fresh(['user', 'section']);
        });
    }

    public function archiveStudent(Student $student): bool
    {
        return $student->update(['is_active' => false]);
    }

    public function restoreStudent(Student $student): bool
    {
        return $student->update(['is_active' => true]);
    }

    public function getStudentsBySection(int $sectionId): Collection
    {
        return Student::with(['user', 'section'])
            ->active()
            ->bySection($sectionId)
            ->orderBy('last_name')
            ->orderBy('first_name')
            ->get();
    }

    public function calculateCompatibilityScores(Student $student, Collection $internships): array
    {
        $scores = [];
        
        foreach ($internships as $internship) {
            $compatibility = $this->calculateCompatibility($student, $internship);
            $scores[] = [
                'internship_id' => $internship->id,
                'compatibility_score' => $compatibility,
                'student_id' => $student->id,
            ];
        }

        return $scores;
    }

    private function calculateCompatibility(Student $student, $internship): float
    {
        // Implementation of compatibility calculation logic
        $studentScores = $student->scores()->with('subCategory')->get();
        $hteWeights = $internship->hte->subcategoryWeights()->with('subCategory')->get();

        $totalScore = 0;
        $totalWeight = 0;

        foreach ($hteWeights as $weight) {
            $studentScore = $studentScores->firstWhere('sub_category_id', $weight->sub_category_id);
            
            if ($studentScore) {
                $totalScore += $studentScore->mean_score * $weight->weight;
                $totalWeight += $weight->weight;
            }
        }

        return $totalWeight > 0 ? ($totalScore / $totalWeight) : 0;
    }
}
```

## **Form Request Validation**

### **Custom Request Classes**
```php
<?php

namespace App\Http\Requests;

use Illuminate\Foundation\Http\FormRequest;
use Illuminate\Validation\Rule;

class StoreStudentRequest extends FormRequest
{
    public function authorize(): bool
    {
        return $this->user()->can('create', Student::class);
    }

    public function rules(): array
    {
        return [
            'student_number' => [
                'required',
                'string',
                'max:50',
                'unique:students,student_number',
                'regex:/^[A-Z0-9-]+$/',
            ],
            'first_name' => [
                'required',
                'string',
                'max:255',
                'regex:/^[a-zA-Z\s\'-]+$/',
            ],
            'last_name' => [
                'required',
                'string',
                'max:255',
                'regex:/^[a-zA-Z\s\'-]+$/',
            ],
            'middle_name' => [
                'nullable',
                'string',
                'max:255',
                'regex:/^[a-zA-Z\s\'-]+$/',
            ],
            'section_id' => [
                'required',
                'integer',
                'exists:sections,id',
            ],
            'specialization' => [
                'nullable',
                'string',
                'max:255',
            ],
            'email' => [
                'required',
                'email',
                'max:255',
                'unique:users,email',
            ],
            'password' => [
                'required',
                'string',
                'min:8',
                'confirmed',
            ],
        ];
    }

    public function messages(): array
    {
        return [
            'student_number.regex' => 'Student number must contain only uppercase letters, numbers, and hyphens.',
            'first_name.regex' => 'First name can only contain letters, spaces, apostrophes, and hyphens.',
            'last_name.regex' => 'Last name can only contain letters, spaces, apostrophes, and hyphens.',
            'password.confirmed' => 'Password confirmation does not match.',
        ];
    }

    public function attributes(): array
    {
        return [
            'student_number' => 'student number',
            'first_name' => 'first name',
            'last_name' => 'last name',
            'middle_name' => 'middle name',
            'section_id' => 'section',
            'email' => 'email address',
        ];
    }
}
```

## **Database Migrations & Seeders**

### **Migration Structure**
```php
<?php

use Illuminate\Database\Migrations\Migration;
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Support\Facades\Schema;

return new class extends Migration
{
    public function up(): void
    {
        Schema::create('students', function (Blueprint $table) {
            $table->id();
            $table->foreignId('user_id')->constrained()->onDelete('cascade');
            $table->string('student_number')->unique();
            $table->string('first_name');
            $table->string('last_name');
            $table->string('middle_name')->nullable();
            $table->foreignId('section_id')->constrained();
            $table->string('specialization')->nullable();
            $table->boolean('is_active')->default(true);
            $table->timestamps();
            $table->softDeletes();

            // Indexes for performance
            $table->index(['section_id', 'is_active']);
            $table->index(['student_number', 'is_active']);
            $table->index(['last_name', 'first_name']);
        });

        Schema::create('student_scores', function (Blueprint $table) {
            $table->id();
            $table->foreignId('student_id')->constrained()->onDelete('cascade');
            $table->foreignId('sub_category_id')->constrained()->onDelete('cascade');
            $table->integer('mean_score');
            $table->timestamps();

            // Composite primary key
            $table->primary(['student_id', 'sub_category_id']);
            
            // Indexes
            $table->index(['sub_category_id', 'mean_score']);
        });
    }

    public function down(): void
    {
        Schema::dropIfExists('student_scores');
        Schema::dropIfExists('students');
    }
};
```

### **Model Factories**
```php
<?php

namespace Database\Factories;

use App\Models\Section;
use App\Models\User;
use Illuminate\Database\Eloquent\Factories\Factory;

class StudentFactory extends Factory
{
    public function definition(): array
    {
        return [
            'user_id' => User::factory(),
            'student_number' => $this->faker->unique()->regexify('[A-Z]{2}-[0-9]{4}'),
            'first_name' => $this->faker->firstName(),
            'last_name' => $this->faker->lastName(),
            'middle_name' => $this->faker->optional(0.3)->firstName(),
            'section_id' => Section::factory(),
            'specialization' => $this->faker->optional(0.7)->randomElement([
                'Web Development',
                'Mobile Development',
                'Data Science',
                'Cybersecurity',
                'UI/UX Design',
            ]),
            'is_active' => $this->faker->boolean(90),
        ];
    }

    public function active(): static
    {
        return $this->state(fn (array $attributes) => [
            'is_active' => true,
        ]);
    }

    public function inactive(): static
    {
        return $this->state(fn (array $attributes) => [
            'is_active' => false,
        ]);
    }
}
