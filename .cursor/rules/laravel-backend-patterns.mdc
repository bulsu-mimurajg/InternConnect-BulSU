## **Middleware & Authorization**

### **Custom Middleware**
```php
<?php

namespace App\Http\Middleware;

use Closure;
use Illuminate\Http\Request;
use Symfony\Component\HttpFoundation\Response;

class EnsureUserHasRole
{
    public function handle(Request $request, Closure $next, string $role): Response
    {
        if (!$request->user() || $request->user()->role !== $role) {
            abort(403, 'Unauthorized access.');
        }

        return $next($request);
    }
}

class HandleInertiaRequests
{
    public function handle(Request $request, Closure $next): Response
    {
        return $next($request);
    }

    public function share(Request $request): array
    {
        return [
            'auth' => [
                'user' => $request->user(),
                'role' => $request->user()?->role,
            ],
            'flash' => [
                'message' => fn () => $request->session()->get('message'),
                'error' => fn () => $request->session()->get('error'),
            ],
            'ziggy' => fn () => [
                'location' => $request->url(),
                'query' => $request->query(),
            ],
        ];
    }
}
```

### **Policy Classes**
```php
<?php

namespace App\Policies;

use App\Models\Student;
use App\Models\User;

class StudentPolicy
{
    public function viewAny(User $user): bool
    {
        return in_array($user->role, ['admin', 'adviser']);
    }

    public function view(User $user, Student $student): bool
    {
        return $this->viewAny($user) || $user->id === $student->user_id;
    }

    public function create(User $user): bool
    {
        return $user->role === 'admin';
    }

    public function update(User $user, Student $student): bool
    {
        return $user->role === 'admin' || $user->id === $student->user_id;
    }

    public function delete(User $user, Student $student): bool
    {
        return $user->role === 'admin';
    }

    public function restore(User $user, Student $student): bool
    {
        return $user->role === 'admin';
    }
}
```

## **Testing Patterns**

### **Feature Tests**
```php
<?php

namespace Tests\Feature;

use App\Models\Student;
use App\Models\User;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Tests\TestCase;

class StudentManagementTest extends TestCase
{
    use RefreshDatabase;

    public function test_admin_can_view_student_list(): void
    {
        $admin = User::factory()->create(['role' => 'admin']);
        $students = Student::factory()->count(5)->create();

        $response = $this->actingAs($admin)
            ->get('/admin/students');

        $response->assertStatus(200)
            ->assertInertia(fn ($page) => 
                $page->component('Admin/Student/List')
                    ->has('students.data', 5)
            );
    }

    public function test_admin_can_create_student(): void
    {
        $admin = User::factory()->create(['role' => 'admin']);
        $studentData = [
            'student_number' => 'CS-2024-001',
            'first_name' => 'John',
            'last_name' => 'Doe',
            'section_id' => 1,
            'email' => 'john.doe@example.com',
            'password' => 'password123',
            'password_confirmation' => 'password123',
        ];

        $response = $this->actingAs($admin)
            ->post('/admin/students', $studentData);

        $response->assertRedirect('/admin/students');
        $this->assertDatabaseHas('students', [
            'student_number' => 'CS-2024-001',
            'first_name' => 'John',
            'last_name' => 'Doe',
        ]);
    }

    public function test_student_cannot_access_admin_routes(): void
    {
        $student = User::factory()->create(['role' => 'student']);

        $response = $this->actingAs($student)
            ->get('/admin/students');

        $response->assertStatus(403);
    }
}
