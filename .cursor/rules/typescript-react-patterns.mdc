## **Testing Patterns**

### **Component Testing**
```typescript
// Test setup with proper typing
import { render, screen, fireEvent } from '@testing-library/react';
import { StudentList } from '@/components/StudentList';

const mockStudents: Student[] = [
  {
    id: 1,
    student_number: '2023-001',
    first_name: 'John',
    last_name: 'Doe',
    section: 'CS-3A',
    is_active: true,
  },
];

describe('StudentList', () => {
  it('renders student list correctly', () => {
    render(<StudentList students={mockStudents} />);
    
    expect(screen.getByText('John Doe')).toBeInTheDocument();
    expect(screen.getByText('2023-001')).toBeInTheDocument();
  });

  it('handles edit button click', () => {
    const mockOnEdit = jest.fn();
    render(<StudentList students={mockStudents} onEdit={mockOnEdit} />);
    
    fireEvent.click(screen.getByRole('button', { name: /edit/i }));
    expect(mockOnEdit).toHaveBeenCalledWith(1);
  });
});
```

