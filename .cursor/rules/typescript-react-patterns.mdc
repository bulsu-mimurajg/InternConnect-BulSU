## **React Component Patterns**

### **Functional Components with Hooks**
```typescript
import { useState, useEffect, useCallback, useMemo } from 'react';
import { useForm } from 'react-hook-form';
import { router } from '@inertiajs/react';

// Component with state management
export default function StudentList({ students, filters }: Props) {
  const [showUnverified, setShowUnverified] = useState(false);
  const [showArchived, setShowArchived] = useState(false);
  const [searchTerm, setSearchTerm] = useState('');

  // Memoized filtered data
  const filteredStudents = useMemo(() => {
    return students.filter(student => 
      student.first_name.toLowerCase().includes(searchTerm.toLowerCase()) ||
      student.last_name.toLowerCase().includes(searchTerm.toLowerCase()) ||
      student.student_number.includes(searchTerm)
    );
  }, [students, searchTerm]);

  // Event handlers with useCallback
  const handleEdit = useCallback((studentId: number | string) => {
    router.get(`/student/${studentId}/edit`);
  }, []);

  const handleArchive = useCallback((studentId: number | string) => {
    if (confirm('Are you sure you want to archive this student?')) {
      router.patch(`/student/${studentId}/archive`);
    }
  }, []);

  return (
    // JSX content
  );
}
```

### **Custom Hooks**
```typescript
// Custom hook for form state management
function useStudentForm(initialData?: Partial<StudentFormData>) {
  const form = useForm<StudentFormData>({
    resolver: zodResolver(StudentFormSchema),
    defaultValues: {
      student_number: '',
      last_name: '',
      first_name: '',
      middle_name: '',
      section: '',
      specialization: '',
      email: '',
      ...initialData,
    },
  });

  const onSubmit = useCallback((values: StudentFormData) => {
    router.post('/students', values, {
      onSuccess: () => {
        form.reset();
        // Show success message
      },
      onError: (errors) => {
        // Handle validation errors
        Object.entries(errors).forEach(([key, value]) => {
          form.setError(key as keyof StudentFormData, {
            type: 'manual',
            message: value as string,
          });
        });
      },
    });
  }, [form]);

  return { form, onSubmit };
}

// Custom hook for API data fetching
function useStudents(filters: StudentFilters) {
  const [students, setStudents] = useState<Student[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    const fetchStudents = async () => {
      try {
        setLoading(true);
        const response = await fetch(`/api/students?${new URLSearchParams(filters)}`);
        const data = await response.json();
        setStudents(data);
      } catch (err) {
        setError(err instanceof Error ? err.message : 'An error occurred');
      } finally {
        setLoading(false);
      }
    };

    fetchStudents();
  }, [filters]);

  return { students, loading, error };
}
```

### **Context Providers**
```typescript
// Form context for multi-step forms
interface FormFieldsContextType {
  registerField: (fieldName: string) => void;
  unregisterField: (fieldName: string) => void;
  validateFields: (fields: string[]) => Promise<boolean>;
}

const FormFieldsContext = createContext<FormFieldsContextType | null>(null);

export function FormFieldsProvider({ children }: { children: React.ReactNode }) {
  const [fields, setFields] = useState<Set<string>>(new Set());

  const registerField = useCallback((fieldName: string) => {
    setFields(prev => new Set(prev).add(fieldName));
  }, []);

  const unregisterField = useCallback((fieldName: string) => {
    setFields(prev => {
      const newFields = new Set(prev);
      newFields.delete(fieldName);
      return newFields;
    });
  }, []);

  const validateFields = useCallback(async (fieldsToValidate: string[]) => {
    // Validation logic
    return true;
  }, []);

  return (
    <FormFieldsContext.Provider value={{
      registerField,
      unregisterField,
      validateFields,
    }}>
      {children}
    </FormFieldsContext.Provider>
  );
}

export function useFormFields() {
  const context = useContext(FormFieldsContext);
  if (!context) {
    throw new Error('useFormFields must be used within FormFieldsProvider');
  }
  return context;
}
```

## **Error Handling & Loading States**

### **Error Boundaries**
```typescript
interface ErrorBoundaryState {
  hasError: boolean;
  error?: Error;
}

class ErrorBoundary extends Component<
  { children: React.ReactNode },
  ErrorBoundaryState
> {
  constructor(props: { children: React.ReactNode }) {
    super(props);
    this.state = { hasError: false };
  }

  static getDerivedStateFromError(error: Error): ErrorBoundaryState {
    return { hasError: true, error };
  }

  componentDidCatch(error: Error, errorInfo: ErrorInfo) {
    console.error('Error caught by boundary:', error, errorInfo);
  }

  render() {
    if (this.state.hasError) {
      return (
        <div className="flex items-center justify-center p-8">
          <div className="text-center">
            <h2 className="text-lg font-semibold text-destructive">
              Something went wrong
            </h2>
            <p className="text-muted-foreground mt-2">
              Please refresh the page and try again.
            </p>
          </div>
        </div>
      );
    }

    return this.props.children;
  }
}
```

### **Loading States**
```typescript
// Loading component
function LoadingSpinner({ size = 'default' }: { size?: 'sm' | 'default' | 'lg' }) {
  const sizeClasses = {
    sm: 'h-4 w-4',
    default: 'h-6 w-6',
    lg: 'h-8 w-8',
  };

  return (
    <div className="flex items-center justify-center">
      <LoaderIcon className={`animate-spin ${sizeClasses[size]}`} />
    </div>
  );
}

// Conditional rendering with loading
export default function StudentList({ students, loading }: Props) {
  if (loading) {
    return (
      <div className="flex items-center justify-center p-8">
        <LoadingSpinner size="lg" />
      </div>
    );
  }

  return (
    // Component content
  );
}
```

